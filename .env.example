# ── Local development (fallback when SECRET_NAME is not set) ──
# Put any runtime keys here for local use. In Lambda, the same keys
# should live inside the Secrets Manager JSON referenced by SECRET_NAME.

# Example (replace with your real keys):
# DATABASE_URL=
# API_TOKEN=

# ── AWS Lambda container (production) ──
SECRET_NAME=
AWS_REGION=us-east-1

# ── CI/CD deploy (scripts/deploy-ecr.sh) ──
# Prefer values from CloudFormation stack outputs after bootstrap.
# ECR_REGISTRY=
# ECR_REPO=onecgiar-ibd-platform-dev
# LAMBDA_FUNCTION_NAME=onecgiar-ibd-platform-dev
# CLOUDFRONT_DISTRIBUTION_ID=
